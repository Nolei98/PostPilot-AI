# ============================================================
# PostPilot AI — variáveis de ambiente
# Copie para .env.local e preencha.
# ============================================================

# --- Supabase (obrigatório) ---------------------------------
# Dashboard do Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# Service role: usada SÓ no backend (jobs Inngest). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# --- Anthropic (pago — ~$3-6/mês no volume do MVP) ----------
# console.anthropic.com → API Keys
# Deixe vazio para usar o MOCK local (triagem e geração falsas, $0)
ANTHROPIC_API_KEY=

# --- Gemini (alternativa ao Anthropic, opcional) -------------
# aistudio.google.com/apikey → tier gratuito bem maior que o Claude
# Só é usado se AI_PROVIDER=gemini (senão o app usa Claude/MOCK acima)
AI_PROVIDER=
GEMINI_API_KEY=

# --- Fal.ai (pago — ~$2/mês) --------------------------------
# fal.ai/dashboard → Keys
# Deixe vazio para usar o MOCK local (imagem placeholder, $0)
FAL_KEY=

# --- Pollinations.ai (grátis, opcional) ----------------------
# Sem key funciona (rate limit 1 req/15s, pode vir com marca d'água
# na imagem). Com key (auth.pollinations.ai): sem marca d'água,
# rate limit maior. Usada se text_provider=pollinations e/ou
# image_provider=pollinations em Ajustes (mesma key pros dois).
POLLINATIONS_API_KEY=

# --- Fotos reais (Pexels principal, Unsplash fallback) -------
# Usadas se image_provider=stock em Ajustes (default). Substitui a
# geração de rostos por IA por fotos reais — evita artefatos em
# rosto/mãos/dentes. Grátis nos dois.
# Pexels: pexels.com/api (aprovação instantânea)
PEXELS_API_KEY=
# Unsplash: unsplash.com/developers → cria um app → "Access Key"
UNSPLASH_ACCESS_KEY=

# --- Telegram (grátis) --------------------------------------
# 1. Fale com @BotFather no Telegram → /newbot → copie o token
# 2. Mande "/start" para o seu bot e pegue seu chat_id em:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# Deixe vazio para desativar notificações localmente
TELEGRAM_BOT_TOKEN=

# --- Inngest (grátis no free tier) --------------------------
# Local: não precisa de chave (npx inngest-cli dev)
# Produção: app.inngest.com → chaves do ambiente
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Meta / Instagram Graph API (grátis — Sprint C) ----------
# developers.facebook.com → cria um app → produto "Instagram Graph API"
# Deixe vazio para usar o MOCK local (conectar/publicar/métricas falsos, $0)
META_APP_ID=
META_APP_SECRET=
# Chave mestra pra cifrar o token de acesso guardado em social_connections.
# Gere com: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# --- NVIDIA NIM (texto — créditos grátis) --------------------
# build.nvidia.com -> API Keys. API compatível com a da OpenAI, então
# não entra SDK novo no projeto (é fetch em /v1/chat/completions).
# Entrou porque o free tier do Gemini são 20 requisições por DIA, o que
# não cobre nem uma varredura completa.
# Usada quando text_provider=nvidia em Ajustes.
NVIDIA_API_KEY=
# Opcional. Padrão: deepseek-ai/deepseek-v4-flash (34s com prompt real).
# ⚠️ Modelo grande nem sempre está disponível: llama-3.1-70b e
# nemotron-49b ficam em FILA no tier grátis e estouram o timeout — com
# prompt CURTO respondem em 2s, o que engana. Meça com carga real.
NVIDIA_MODEL=
# Rede de segurança quando o principal está enfileirado.
# Padrão: meta/llama-3.1-8b-instruct (14s).
NVIDIA_FALLBACK_MODEL=

# --- Stripe (assinatura) ------------------------------------
# dashboard.stripe.com → Developers → API keys
# Em TESTE as chaves começam com sk_test_ e nada é cobrado de verdade.
# Para cobrar: chave sk_live_, produtos recriados no modo live e um
# STRIPE_WEBHOOK_SECRET novo (o secret é por endpoint E por modo).
STRIPE_SECRET_KEY=
# Webhook: Developers → Webhooks → endpoint .../api/stripe/webhook
# Sem esse secret a assinatura do webhook não valida e o pagamento
# nunca sincroniza com o plano do usuário.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) dos produtos criados no dashboard.
# Sem eles o checkout do plano correspondente não abre.
STRIPE_PRICE_CRIADOR=
STRIPE_PRICE_PRO=

# --- App ----------------------------------------------------
# URL pública do app (produção: https://seu-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
