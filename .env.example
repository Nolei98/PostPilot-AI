# ============================================================
# PostPilot AI — variáveis de ambiente
# Copie para .env.local e preencha.
# ============================================================

# --- Supabase (obrigatório) ---------------------------------
# Dashboard do Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# Service role: usada SÓ no backend (jobs Inngest). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# --- Anthropic (pago — ~$3-6/mês no volume do MVP) ----------
# console.anthropic.com → API Keys
# Deixe vazio para usar o MOCK local (triagem e geração falsas, $0)
ANTHROPIC_API_KEY=

# --- Gemini (alternativa ao Anthropic, opcional) -------------
# aistudio.google.com/apikey → tier gratuito bem maior que o Claude
# Só é usado se AI_PROVIDER=gemini (senão o app usa Claude/MOCK acima)
AI_PROVIDER=
GEMINI_API_KEY=

# --- Fal.ai (pago — ~$2/mês) --------------------------------
# fal.ai/dashboard → Keys
# Deixe vazio para usar o MOCK local (imagem placeholder, $0)
FAL_KEY=

# --- Pollinations.ai (grátis, opcional) ----------------------
# Sem key funciona (rate limit 1 req/15s, pode vir com marca d'água
# na imagem). Com key (auth.pollinations.ai): sem marca d'água,
# rate limit maior. Usada se text_provider=pollinations e/ou
# image_provider=pollinations em Ajustes (mesma key pros dois).
POLLINATIONS_API_KEY=

# --- Telegram (grátis) --------------------------------------
# 1. Fale com @BotFather no Telegram → /newbot → copie o token
# 2. Mande "/start" para o seu bot e pegue seu chat_id em:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# Deixe vazio para desativar notificações localmente
TELEGRAM_BOT_TOKEN=

# --- Inngest (grátis no free tier) --------------------------
# Local: não precisa de chave (npx inngest-cli dev)
# Produção: app.inngest.com → chaves do ambiente
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ----------------------------------------------------
# URL pública do app (produção: https://seu-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
